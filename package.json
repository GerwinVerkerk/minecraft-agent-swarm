{
  "name": "minecraft-agent-swarm",
  "version": "2.0.0",
  "description": "A self-improving swarm of local-LLM agents that mine, smelt, build, farm, and fight their way through Minecraft as a coordinated team. Built on mineflayer + Ollama.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts && node scripts/copy-generated-worker.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --exclude \"src/skills/**\" --exclude \"skills/voyager/**\" --exclude \"skills/generated/**\" src/index.ts --hot-reload-skills",
    "start": "tsx --max-old-space-size=8192 src/index.ts",
    "server": "cd server && java -Xmx2G -Xms1G -jar paper.jar --nogui",
    "download-skills": "node scripts/download-voyager-skills.mjs",
    "test": "node scripts/test-runner.mjs",
    "test:native-packets": "node --test scripts/test-native-263-packets.mjs",
    "test:sandbox": "node scripts/test-runner.mjs src/skills/generated-sandbox.qualification.ts",
    "generated-skill": "node --import tsx src/skills/generated-cli.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "swarm": "bash scripts/run-swarm.sh"
  },
  "keywords": [
    "minecraft",
    "ai",
    "llm",
    "twitch",
    "mineflayer",
    "ollama"
  ],
  "author": "JesseRWeigel",
  "license": "MIT",
  "dependencies": {
    "@nxg-org/mineflayer-custom-pvp": "^1.7.6",
    "canvas": "^3.2.1",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "minecraft-data": "https://github.com/GerwinVerkerk/node-minecraft-data/releases/download/pc-26.3-data-924e26d-types/minecraft-data-3.117.0-pc26.3-pr1301-924e26d-types.tgz",
    "minecraft-protocol": "https://codeload.github.com/PrismarineJS/node-minecraft-protocol/tar.gz/a1a33809c49553e544a7efd3d8bc03eb0867f4ab",
    "mineflayer": "https://codeload.github.com/GerwinVerkerk/mineflayer/tar.gz/fbf668d1a2da3b9ec3e4c0276c4b0a4bf9b87396",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.4.1",
    "mineflayer-pathfinder": "^2.4.5",
    "msedge-tts": "^2.0.4",
    "ollama": "^0.5.0",
    "prismarine-chunk": "https://codeload.github.com/PrismarineJS/prismarine-chunk/tar.gz/7382b4fef1c56290524665e7b9af58b7d1f34791",
    "prismarine-physics": "https://codeload.github.com/PrismarineJS/prismarine-physics/tar.gz/b928638645a56a110a51da1f2080c6455b27984a",
    "prismarine-viewer": "^1.33.0",
    "rcon-client": "^4.2.5",
    "socket.io": "^4.8.3",
    "tmi.js": "^1.8.5",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/tmi.js": "^1.8.6",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.1"
  }
}
